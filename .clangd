---
CompileFlags:
    # The database is not configured here on purpose: the root CMakeLists links
    # build/presetName/compile_commands.json up into build/, where clangd finds it on its
    # own. That keeps this file from pinning the index to one preset.
    Compiler: clang-cl

    # /JMC is MSVC-only and makes clang-cl bail on the whole command.
    Remove: ["/JMC"]

    Add: [
      "-Wno-missing-field-initializers"
    ]

InlayHints:
  Designators: No
  Enabled: No
  ParameterNames: Yes
  DeducedTypes: No
