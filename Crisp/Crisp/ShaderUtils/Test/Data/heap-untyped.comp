// Unsized arrays index the bound resource heap directly, so no declaration carries a set or binding. glslang
// emits this against SPV_KHR_untyped_pointers, which is what spirv-reflect cannot currently parse — see the
// DescriptorHeapReflectionTest case that pins the failure.
#version 460 core
#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(descriptor_heap) uniform Camera { mat4 viewProjection; } camera[];
layout(descriptor_heap, rgba32f) uniform image2D target[];
layout(descriptor_heap) buffer Counters { uint data[]; } counters[];

layout(push_constant, std430) uniform Slots {
    uint cameraSlot;
    uint targetSlot;
    uint counterSlot;
} slots;

void main() {
    const ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    const uint index = counters[slots.counterSlot].data[0];
    const vec4 projected = camera[slots.cameraSlot].viewProjection * vec4(position, 0.0, 1.0);

    imageStore(target[slots.targetSlot], position, projected);
    counters[slots.counterSlot].data[0] = index + 1;
}
