{
    "shaders": {
        "vert": "fullscreen-quad.vert",
        "frag": "sky-ray-march.frag"
    },
    "vertexInputBindings": [
        { "formats": [ "vec2" ], "inputRate": "vertex" }
    ],
    "vertexAttributes": [ [ "vec2" ] ],
