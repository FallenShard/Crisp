<?xml version="1.0" encoding="utf-8"?>
<!--
    Mitsuba reference for VulkanRayTracingScene's hard-coded cbox-mats scene.

    Keep this file aligned with:
      Resources/VesperScenes/Nori-PA-4/cbox-mats.json
      Crisp/Crisp/Scenes/VulkanRayTracingScene.cpp

    VulkanRayTracingScene currently applies only the camera position and vertical
    FOV from the JSON file. FreeCameraController starts pointed along -Z, so the
    JSON target is intentionally not used here.
-->
<scene version="3.0.0">
    <integrator type="path">
        <integer name="max_depth" value="32"/>
        <integer name="rr_depth" value="5"/>
    </integrator>

    <sensor type="perspective">
        <string name="fov_axis" value="y"/>
        <float name="fov" value="27.7856"/>
        <float name="near_clip" value="0.1"/>
        <float name="far_clip" value="1000.0"/>
        <transform name="to_world">
            <lookat origin="0, 0.919769, 5.41159"
                    target="0, 0.919769, 4.41159"
                    up="0, 1, 0"/>
        </transform>
        <sampler type="independent">
            <integer name="sample_count" value="1024"/>
        </sampler>
        <film type="hdrfilm">
            <integer name="width" value="1920"/>
            <integer name="height" value="1080"/>
            <string name="pixel_format" value="rgb"/>
            <string name="component_format" value="float32"/>
            <rfilter type="box"/>
        </film>
    </sensor>

    <bsdf type="diffuse" id="white">
        <rgb name="reflectance" value="0.725, 0.71, 0.68"/>
    </bsdf>
    <bsdf type="diffuse" id="right-wall">
        <rgb name="reflectance" value="0.161, 0.133, 0.427"/>
    </bsdf>
    <bsdf type="diffuse" id="left-wall">
        <rgb name="reflectance" value="0.63, 0.065, 0.05"/>
    </bsdf>
    <bsdf type="diffuse" id="light-surface">
        <rgb name="reflectance" value="0.5, 0.5, 0.5"/>
    </bsdf>
    <bsdf type="conductor" id="mirror">
        <string name="material" value="none"/>
    </bsdf>
    <bsdf type="dielectric" id="glass">
        <float name="int_ior" value="1.5046"/>
        <float name="ext_ior" value="1.0"/>
    </bsdf>

    <shape type="obj">
        <string name="filename" value="../../../Resources/Meshes/walls.obj"/>
        <ref id="white"/>
    </shape>
    <shape type="obj">
        <string name="filename" value="../../../Resources/Meshes/rightwall.obj"/>
        <ref id="right-wall"/>
    </shape>
    <shape type="obj">
        <string name="filename" value="../../../Resources/Meshes/leftwall.obj"/>
        <ref id="left-wall"/>
    </shape>
    <shape type="obj">
        <string name="filename" value="../../../Resources/Meshes/light.obj"/>
        <ref id="light-surface"/>
        <emitter type="area">
            <rgb name="radiance" value="15, 15, 15"/>
        </emitter>
    </shape>
    <shape type="obj">
        <string name="filename" value="../../../Resources/Meshes/sphere.obj"/>
        <transform name="to_world">
            <matrix value="0.3263 0 0 -0.4214  0 0.3263 0 0.3321  0 0 0.3263 -0.28  0 0 0 1"/>
        </transform>
        <ref id="mirror"/>
    </shape>
    <shape type="obj">
        <string name="filename" value="../../../Resources/Meshes/sphere.obj"/>
        <transform name="to_world">
            <matrix value="0.3263 0 0 0.4458  0 0.3263 0 0.3321  0 0 0.3263 0.3767  0 0 0 1"/>
        </transform>
        <ref id="glass"/>
    </shape>
</scene>
